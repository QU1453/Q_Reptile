# 复制为 .env 后填写真实值，.env 不要提交到版本库

# LLM（DeepSeek 或通义，二选一）
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# 邮箱验证服务
EMAIL_VERIFY_KEY=

# 发信服务
RESEND_API_KEY=

# ---------- 多智能体骨架新增（OpenAI 兼容接口） ----------
# 留空则全部走 classic 规则兜底，不会联网调用模型
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# 约束层：plan（写操作需 confirm）/ auto / readonly
AGENT_PERMISSION_MODE=plan
# 网络策略：allowlist（按域名白名单，留空则只校验协议）/ block
TOOL_NET_POLICY=allowlist
TOOL_NET_ALLOWLIST=
# 工具可写路径根，留空默认项目根；多个用系统分隔符
TOOL_PATH_ROOTS=

# 预算与发信
MAX_TOOL_CALLS=12
REACT_MAX_ROUNDS=4
CONTEXT_CHAR_BUDGET=6000
DAILY_MAIL_LIMIT=50
# true：发送只写日志，不真正外发
DRY_RUN_MAIL=true
